# Copy this to .env and fill in your values
# NEVER commit .env to git

# Server
PORT=3001
NODE_ENV=development

# JWT — generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_min_64_chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Database (SQLite — path relative to server root)
DB_PATH=./snap_kampala.db

# CORS — your frontend URL(s), comma separated
CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app
